{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "CashboxSettings": [],
  "ReceiptFailedReprocessing": {
    "LookbackDays": 7,
    "FailedOlderThanHours": 1,
    "MaxReprocessingAttempts": 3,
    "ScheduleRunHours": [ 10, 17 ],
    "WorkerInterval": "00:30:00",
    "CriticalFiscalDriveErrors": [
      "FnMemoryFull",
      "FnCrypt",
      "ResourceExhausted"
    ],
    "CriticalValidationErrors": [
      "ValidationError",
      "InvalidPaymentDetails"
    ]
  }
}
