{
	"DatabaseConnectionSettings": {
		"ServerName": "",
		"Port": 0,
		"DatabaseName": "",
		"UserName": "",
		"Password": ""
	},
	"MessageTransport": {
		"Host": "",
		"Port": "5671",
		"VirtualHost": "online_orders",
		"Username": "",
		"Password": "",
		"UseSSL": true,
		"AllowSslPolicyErrors": "None"
	},
	"NLog": {
		"autoReload": true,
		"autoShutdown": true,
		"extensions": [
			{ "assembly": "NLog.Targets.Seq" }
		],
		"variables": {
			"logDirectory": "/var/log/Mindbox.CounterpartySender"
		},
		"targets": {
			"async": true,
			"logfile": {
				"type": "File",
				"fileName": "${logDirectory}/common.log",
				"archiveFileName": "${logDirectory}/common.{#}.log",
				"archiveEvery": "Day",
				"archiveNumbering": "Rolling",
				"maxArchiveFiles": 3,
				"layout": "${longdate}|${uppercase:${level}}|${logger:shortName=true}|${message} ${onexception:${newline}${exception:format=tostring}}"
			},
			"console": {
				"type": "ColoredConsole",
				"layout": "${longdate}|${uppercase:${level}}|${logger}|${message} ${onexception:${newline}${exception:format=tostring}}"
			}
		},
		"rules": [
			{
				"logger": "*",
				"minLevel": "Trace",
				"writeTo": "console"
			},
			{
				"logger": "*",
				"minLevel": "Debug",
				"writeTo": "logfile"
			}
		]
	}
}
