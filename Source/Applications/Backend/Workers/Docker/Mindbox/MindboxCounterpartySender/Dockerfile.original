FROM mcr.microsoft.com/dotnet/runtime:5.0 AS base
WORKDIR /app

FROM mcr.microsoft.com/dotnet/sdk:5.0 AS build
WORKDIR /src
COPY . .
RUN dotnet restore "Applications/Backend/Workers/Docker/Mindbox/MindboxCounterpartySender/MindboxCounterpartySender.csproj"
RUN dotnet publish "Applications/Backend/Workers/Docker/Mindbox/MindboxCounterpartySender/MindboxCounterpartySender.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "MindboxCounterpartySender.dll"]
