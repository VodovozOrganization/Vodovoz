<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2005/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Description>Пояснительная записка по корректировке чека</Description>
  <Author></Author>
  <PageHeight>11.69in</PageHeight>
  <PageWidth>8.27in</PageWidth>
  <Width>494pt</Width>
  <TopMargin>15mm</TopMargin>
  <LeftMargin>18mm</LeftMargin>
  <RightMargin>18mm</RightMargin>
  <BottomMargin>15mm</BottomMargin>
  <PageHeader>
    <Height>0pt</Height>
    <PrintOnFirstPage>false</PrintOnFirstPage>
    <PrintOnLastPage>false</PrintOnLastPage>
  </PageHeader>
  <Body>
    <Height>720.9pt</Height>
    <Columns>1</Columns>
    <ReportItems>
      <!-- Шапка справа: кому / от кого -->
      <Textbox Name="tbHeader">
        <Height>93.6pt</Height>
        <Width>235.4pt</Width>
        <Value>={?header}</Value>
        <Left>258.6pt</Left>
        <Top>0pt</Top>
        <CanGrow>true</CanGrow>
        <Style>
          <FontFamily>Arial</FontFamily>
          <FontSize>12pt</FontSize>
          <TextAlign>Right</TextAlign>
          <VerticalAlign>Top</VerticalAlign>
          <BorderStyle>
            <Default>None</Default>
          </BorderStyle>
          <BorderColor />
          <BorderWidth />
        </Style>
      </Textbox>
      <!-- Заголовок -->
      <Textbox Name="tbTitle">
        <Height>25.2pt</Height>
        <Width>494pt</Width>
        <Value>={?title}</Value>
        <Left>0pt</Left>
        <Top>108pt</Top>
        <Style>
          <FontFamily>Arial</FontFamily>
          <FontSize>14pt</FontSize>
          <FontWeight>Bold</FontWeight>
          <TextAlign>Center</TextAlign>
          <VerticalAlign>Middle</VerticalAlign>
          <BorderStyle>
            <Default>None</Default>
          </BorderStyle>
          <BorderColor />
          <BorderWidth />
        </Style>
      </Textbox>
      <!-- Текст записки -->
      <Textbox Name="tbBody">
        <Height>417.6pt</Height>
        <Width>494pt</Width>
        <Value>={?body}</Value>
        <Left>0pt</Left>
        <Top>144pt</Top>
        <CanGrow>true</CanGrow>
        <Style>
          <FontFamily>Arial</FontFamily>
          <FontSize>12pt</FontSize>
          <TextAlign>Justify</TextAlign>
          <VerticalAlign>Top</VerticalAlign>
          <BorderStyle>
            <Default>None</Default>
          </BorderStyle>
          <BorderColor />
          <BorderWidth />
        </Style>
      </Textbox>
      <!-- Дата | факсимиле / подпись -->
      <Textbox Name="tbDate">
        <Height>21.6pt</Height>
        <Width>180pt</Width>
        <Value>={?date_text}</Value>
        <Left>0pt</Left>
        <Top>583.2pt</Top>
        <Style>
          <FontFamily>Arial</FontFamily>
          <FontSize>12pt</FontSize>
          <TextAlign>Left</TextAlign>
          <VerticalAlign>Middle</VerticalAlign>
          <BorderStyle>
            <Default>None</Default>
          </BorderStyle>
          <BorderColor />
          <BorderWidth />
        </Style>
      </Textbox>
      <Textbox Name="tbFacsimile">
        <Height>21.6pt</Height>
        <Width>242.6pt</Width>
        <Value>={?facsimile}</Value>
        <Left>251.4pt</Left>
        <Top>583.2pt</Top>
        <Style>
          <FontFamily>Arial</FontFamily>
          <FontSize>12pt</FontSize>
          <TextAlign>Right</TextAlign>
          <VerticalAlign>Middle</VerticalAlign>
          <BorderStyle>
            <Default>None</Default>
          </BorderStyle>
          <BorderColor />
          <BorderWidth />
        </Style>
        <Visibility>
          <Hidden>={?hide_facsimile}</Hidden>
        </Visibility>
      </Textbox>
      <Image Name="imgSignature" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2005/01/reportdefinition">
        <Height>100.8pt</Height>
        <Width>230.4pt</Width>
        <Left>251.4pt</Left>
        <Top>568.8pt</Top>
        <Style>
          <BorderStyle />
          <BorderColor />
          <BorderWidth />
        </Style>
        <Source>Database</Source>
        <Value>=First({signature}, "Signature")</Value>
        <MIMEType>image/png</MIMEType>
        <Sizing>FitProportional</Sizing>
        <ZIndex>2</ZIndex>
        <Visibility>
          <Hidden>={?hide_signature}</Hidden>
        </Visibility>
      </Image>
    </ReportItems>
  </Body>
  <PageFooter>
    <Height>0pt</Height>
    <PrintOnFirstPage>false</PrintOnFirstPage>
    <PrintOnLastPage>false</PrintOnLastPage>
  </PageFooter>
  <DataElementName>Report</DataElementName>
  <DataElementStyle>AttributeNormal</DataElementStyle>
  <DataSets>
    <DataSet Name="Signature">
      <Query>
        <DataSourceName>DS1</DataSourceName>
        <CommandText>SELECT binary_file AS signature
FROM stored_resource
WHERE id = @signature_id</CommandText>
        <QueryParameters>
          <QueryParameter Name="signature_id">
            <Value>={?signature_id}</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="signature">
          <DataField>signature</DataField>
          <TypeName>System.String</TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <DataSources>
    <DataSource Name="DS1">
      <ConnectionProperties>
        <DataProvider>MySqlConnector</DataProvider>
        <ConnectString>database=Vodovoz_;user=;password=;port=3306;server=vod.qsolution.ru</ConnectString>
        <IntegratedSecurity>false</IntegratedSecurity>
      </ConnectionProperties>
    </DataSource>
  </DataSources>
  <ReportParameters>
    <ReportParameter Name="header">
      <DataType>String</DataType>
      <Nullable>true</Nullable>
      <AllowBlank>true</AllowBlank>
      <MultiValue>false</MultiValue>
      <Prompt></Prompt>
    </ReportParameter>
    <ReportParameter Name="title">
      <DataType>String</DataType>
      <Nullable>true</Nullable>
      <AllowBlank>true</AllowBlank>
      <MultiValue>false</MultiValue>
      <Prompt></Prompt>
    </ReportParameter>
    <ReportParameter Name="body">
      <DataType>String</DataType>
      <Nullable>true</Nullable>
      <AllowBlank>true</AllowBlank>
      <MultiValue>false</MultiValue>
      <Prompt></Prompt>
    </ReportParameter>
    <ReportParameter Name="date_text">
      <DataType>String</DataType>
      <Nullable>true</Nullable>
      <AllowBlank>true</AllowBlank>
      <MultiValue>false</MultiValue>
      <Prompt></Prompt>
    </ReportParameter>
    <ReportParameter Name="facsimile">
      <DataType>String</DataType>
      <Nullable>true</Nullable>
      <AllowBlank>true</AllowBlank>
      <MultiValue>false</MultiValue>
      <Prompt></Prompt>
    </ReportParameter>
    <ReportParameter Name="signature_id">
      <DataType>Integer</DataType>
      <Nullable>false</Nullable>
      <AllowBlank>false</AllowBlank>
      <MultiValue>false</MultiValue>
      <Prompt></Prompt>
    </ReportParameter>
    <ReportParameter Name="hide_signature">
      <DataType>Boolean</DataType>
      <Nullable>false</Nullable>
      <AllowBlank>false</AllowBlank>
      <MultiValue>false</MultiValue>
      <Prompt></Prompt>
    </ReportParameter>
    <ReportParameter Name="hide_facsimile">
      <DataType>Boolean</DataType>
      <Nullable>false</Nullable>
      <AllowBlank>false</AllowBlank>
      <MultiValue>false</MultiValue>
      <Prompt></Prompt>
    </ReportParameter>
  </ReportParameters>
</Report>
