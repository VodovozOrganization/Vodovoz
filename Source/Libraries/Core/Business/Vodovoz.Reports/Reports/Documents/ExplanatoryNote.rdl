  <DataElementName>Report</DataElementName>
  <DataElementStyle>AttributeNormal</DataElementStyle>
  <DataSets>
    <DataSet Name="Signature">
      <Query>
        <DataSourceName>DS1</DataSourceName>
        <CommandText>SELECT binary_file AS signature
FROM stored_resource
WHERE id = @signature_id</CommandText>
        <QueryParameters>
          <QueryParameter Name="signature_id">
            <Value>={?signature_id}</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="signature">
          <DataField>signature</DataField>
          <TypeName>System.String</TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Positions">
      <Query>
        <DataSourceName>DS1</DataSourceName>
        <CommandText>SELECT
	line_number AS row_num,
	name,
	quantity,
	price,
	discount_sum AS discount,
	sum AS line_sum
FROM receipt_correction_explanatory_note_items
WHERE explanatory_note_id = @note_id
ORDER BY line_number;</CommandText>
        <QueryParameters>
          <QueryParameter Name="note_id">
            <Value>=Parameters!note_id</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="row_num">
          <DataField>row_num</DataField>
          <TypeName>System.Int32</TypeName>
        </Field>
        <Field Name="name">
          <DataField>name</DataField>
          <TypeName>System.String</TypeName>
        </Field>
        <Field Name="quantity">
          <DataField>quantity</DataField>
          <TypeName>System.Decimal</TypeName>
        </Field>
        <Field Name="price">
          <DataField>price</DataField>
          <TypeName>System.Decimal</TypeName>
        </Field>
        <Field Name="discount">
          <DataField>discount</DataField>
          <TypeName>System.Decimal</TypeName>
        </Field>
        <Field Name="line_sum">
          <DataField>line_sum</DataField>
          <TypeName>System.Decimal</TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <DataSources>
    <DataSource Name="DS1">
      <ConnectionProperties>
        <DataProvider>MySqlConnector</DataProvider>
        <ConnectString>database=Vodovoz_;user=;password=;port=3306;server=vod.qsolution.ru</ConnectString>
        <IntegratedSecurity>false</IntegratedSecurity>
      </ConnectionProperties>
    </DataSource>
  </DataSources>
  <ReportParameters>
    <ReportParameter Name="note_id">
      <DataType>Integer</DataType>
      <Nullable>false</Nullable>
      <AllowBlank>false</AllowBlank>
      <MultiValue>false</MultiValue>
