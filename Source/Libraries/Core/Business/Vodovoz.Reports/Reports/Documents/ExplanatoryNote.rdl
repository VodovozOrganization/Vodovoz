    <ReportParameter Name="hide_standalone_footer">
      <DataType>Boolean</DataType>
      <Nullable>false</Nullable>
      <AllowBlank>false</AllowBlank>
      <MultiValue>false</MultiValue>
      <Prompt></Prompt>
